<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{2397577A-10B3-48EC-93EF-0B0AE5947665}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ZenlessSteamBridge</RootNamespace>
    <AssemblyName>ZenlessSteamBridge</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CodePage>65001</CodePage><GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefineConstants></DefineConstants>
    <BridgeFrontendPath>obj\$(Configuration)\ZenlessBridge.exe</BridgeFrontendPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Web.Extensions" /><Reference Include="System.Management" />
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="assets\zenless.png"><LogicalName>ZenlessSteamBridge.ZenlessArt</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\starrail.png"><LogicalName>ZenlessSteamBridge.StarRailArt</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="LICENSE"><LogicalName>ZenlessSteamBridge.License</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="$(BridgeFrontendPath)"><LogicalName>ZenlessSteamBridge.Frontend</LogicalName></EmbeddedResource>
    <None Include="app.manifest" /><None Include="bridge.manifest" /><None Include="README.md" /><None Include="使用说明.txt" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="BuildBridgeFrontend" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <MakeDir Directories="obj\$(Configuration)" />
    <ItemGroup>
      <FrontendResource Include="assets\zenless.png"><LogicalName>ZenlessSteamBridge.ZenlessArt</LogicalName></FrontendResource>
      <FrontendResource Include="assets\starrail.png"><LogicalName>ZenlessSteamBridge.StarRailArt</LogicalName></FrontendResource>
      <FrontendResource Include="LICENSE"><LogicalName>ZenlessSteamBridge.License</LogicalName></FrontendResource>
    </ItemGroup>
    <Csc NoConfig="true" Sources="@(Compile)" References="@(ReferencePath)" Resources="@(FrontendResource)" OutputAssembly="$(BridgeFrontendPath)" TargetType="winexe" Platform="x64" Optimize="true" CodePage="65001" DefineConstants="BRIDGE_FRONTEND;$(DefineConstants)" Win32Manifest="bridge.manifest" />
  </Target>
</Project>
